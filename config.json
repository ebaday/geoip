{
  "input": [
    {
      "type": "v2rayGeoIPDat",
      "action": "add",
      "args": {
        "uri": "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat"
      }
    },
    {
      "type": "maxmindGeoLite2ASNCSV",
      "action": "add",
      "args": {
        "ipv4": "./geolite2/GeoLite2-ASN-Blocks-IPv4.csv",
        "ipv6": "./geolite2/GeoLite2-ASN-Blocks-IPv6.csv",
        "wantedList": {
          "akamai": [
            "AS12222",
            "AS16625",
            "AS17204",
            "AS20940",
            "AS21342",
            "AS24319",
            "AS26008",
            "AS31108",
            "AS32787",
            "AS33905",
            "AS34164",
            "AS35994",
            "AS36183",
            "AS49846",
            "AS63949",
            "AS200005",
            "AS213120",
            "AS393234",
            "AS393560"
          ],
          "cdn77": [ "60068" ]
        }
      }
    },
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "amazon",
        "uri": "https://ip-ranges.amazonaws.com/ip-ranges.json",
        "jsonPath": [
          "prefixes.#(service==\"AMAZON\")#.ip_prefix",
          "ipv6_prefixes.#(service==\"AMAZON\")#.ipv6_prefix"
        ]
      }
    },
    {
      "type": "json",
      "action": "add",
      "args": {
        "name": "github",
        "uri": "https://api.github.com/meta",
        "jsonPath": [
          "hooks",
          "web",
          "api",
          "git",
          "github_enterprise_importer",
          "packages",
          "pages",
          "importer",
          "actions",
          "actions_macos",
          "codespaces",
          "copilot"
        ]
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "microsoft",
        "uri": "https://raw.githubusercontent.com/lord-alfred/ipranges/main/microsoft/ipv4.txt",
        "onlyIPType": "ipv4"
      }
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "microsoft",
        "uri": "https://raw.githubusercontent.com/lord-alfred/ipranges/main/microsoft/ipv6.txt",
        "onlyIPType": "ipv6"
      }
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip.dat"
      }
    },
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip-asn.dat",
        "wantedList": [
          "cloudflare",
          "cloudfront",
          "facebook",
          "fastly",
          "google",
          "netflix",
          "telegram",
          "twitter",
          "akamai",
          "cdn77",
          "microsoft",
          "amazon",
          "github"
        ]
      }
    },
    {
      "type": "text",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "onlyIPType": "ipv4",
        "wantedList": [
          "cloudflare",
          "cloudfront",
          "facebook",
          "fastly",
          "google",
          "netflix",
          "telegram",
          "twitter",
          "akamai",
          "cdn77",
          "microsoft",
          "amazon",
          "github"
        ]
      }
    }
  ]
}
